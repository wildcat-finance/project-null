[Unit]
Description=Project Null retention and export maintenance

[Service]
Type=oneshot
User=project-null
Group=project-null
WorkingDirectory=/opt/project-null
EnvironmentFile=/etc/project-null/project-null.env
ExecStart=/opt/project-null/.venv/bin/python /opt/project-null/maintenance.py
NoNewPrivileges=true
CapabilityBoundingSet=
DevicePolicy=closed
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/project-null
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
